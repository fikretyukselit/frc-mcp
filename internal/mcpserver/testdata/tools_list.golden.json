  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Look up FRC API symbol"
    },
    "description": "Look up an exact API symbol (class, method, constructor, field) for one FRC season and language: signatures, deprecation/removal, replacement, and where the same symbol lives in other seasons.\n\nUse when: you know or suspect a class/method name (TalonFX, SparkMax#configure, frc::SwerveDriveKinematics, edu.wpi.first.math.kinematics.SwerveDriveKinematics) and need its current, correct form — especially before writing code against it.\nDon't use when: you have a conceptual question — call frc_search.\n\nstatus \"version_mismatch\" means the symbol does not exist in the pinned season (e.g. CANSparkMax in 2025+, edu.wpi.first packages in 2027). Examples:\n{\"symbol\": \"TalonFX#TalonFX\", \"language\": \"java\"}\n{\"symbol\": \"SwerveDriveKinematics\", \"frc_season\": \"2027\"}",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "frc_season": {
          "description": "FRC season, e.g. 2026. Defaults to the current stable season",
          "pattern": "^20[2-3][0-9]$",
          "type": "string"
        },
        "language": {
          "description": "java, cpp or python; empty searches all languages",
          "enum": [
            "java",
            "cpp",
            "python",
            "any"
          ],
          "type": "string"
        },
        "limit": {
          "description": "maximum matches (default 10, max 50)",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "pin": {
          "description": "pin handle from frc_context; supplies season and language unless given explicitly",
          "type": "string"
        },
        "symbol": {
          "description": "class, member or qualified name: TalonFX, SparkMax#configure, frc::DCMotor, edu.wpi.first.wpilibj.TimedRobot",
          "maxLength": 300,
          "type": "string"
        }
      },
      "required": [
        "symbol"
      ],
      "type": "object"
    },
