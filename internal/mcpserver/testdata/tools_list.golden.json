  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Search FRC docs"
    },
    "description": "Search FRC documentation, API references and release notes, pinned to one FRC season.\n\nUse when: you need to know how to do something with WPILib or a vendor library (e.g. \"configure Motion Magic on a TalonFX\", \"swerve odometry with PhotonVision\"), or what changed between versions.\nDon't use when: you already know the exact class or method name and need its signature — call frc_api. To read a whole section, call frc_fetch with a hit's id.\n\nResults carry citations, trust tiers and the effective season. Forum content is excluded unless kinds includes \"forum\" or the query describes an error. Examples:\n{\"query\": \"How do I configure Motion Magic on a TalonFX?\", \"language\": \"java\"}\n{\"query\": \"SwerveDriveKinematics toSwerveModuleStates\", \"frc_season\": \"2027\"}",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "description": "release channel of the pinned season",
          "enum": [
            "stable",
            "beta",
            "alpha"
          ],
          "type": "string"
        },
        "cursor": {
          "description": "next_cursor from a previous frc_search call with the same arguments",
          "type": "string"
        },
        "frc_season": {
          "description": "FRC season to pin results to, e.g. 2026. Defaults to the current stable season",
          "pattern": "^20[2-3][0-9]$",
          "type": "string"
        },
        "k": {
          "description": "number of results per page (default 5)",
          "maximum": 20,
          "minimum": 1,
          "type": "integer"
        },
        "kinds": {
          "description": "restrict content kinds; include forum to opt in to community posts",
          "items": {
            "enum": [
              "prose",
              "code",
              "api",
              "release",
              "rule",
              "forum"
            ],
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "language": {
          "description": "robot code language; 'any' disables the filter",
          "enum": [
            "java",
            "cpp",
            "python",
            "any"
          ],
          "type": "string"
        },
        "libraries": {
          "description": "restrict to library ids, e.g. wpilib, phoenix6, revlib, photonvision, pathplannerlib",
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "max_tokens": {
          "description": "token budget for the whole response (default 2500, max 20000)",
          "maximum": 20000,
          "minimum": 1,
          "type": "integer"
        },
        "pin": {
          "description": "pin handle from frc_context; supplies season and language unless given explicitly",
          "type": "string"
        },
        "query": {
          "description": "what you are looking for, in natural language or with exact class/method names",
          "maxLength": 2000,
          "type": "string"
        },
        "response_format": {
          "description": "concise (default) or detailed snippets",
          "enum": [
            "concise",
            "detailed"
          ],
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "name": "frc_search",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "description": "0..1 confidence in the top result",
          "type": "number"
        },
        "degraded": {
          "description": "retrievers that were unavailable for this call",
