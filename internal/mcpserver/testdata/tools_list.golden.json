  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Detect FRC project versions"
    },
    "description": "Detect (or declare) the robot project's FRC season, language, WPILib version and vendordep versions, and return a pin handle that makes every other frc_ tool answer for exactly that project.\n\nUse when: starting work in a robot project, or when results come back for the wrong season or language. Call it once and pass the returned pin to frc_search and frc_api.\nDon't use when: you only need a one-off lookup for a season you already know — pass frc_season directly.\n\nReads only build.gradle / build.gradle.kts, pyproject.toml and vendordeps/*.json under the project root. Warnings flag vendordeps whose frcYear does not match the WPILib season. Examples:\n{}\n{\"project_root\": \"/path/to/robot\"}\n{\"declare\": {\"frc_season\": \"2027\", \"language\": \"java\"}}",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "declare": {
          "additionalProperties": false,
          "description": "declare the pin set instead of (or on top of) detecting it",
          "properties": {
            "channel": {
              "description": "stable, beta or alpha",
              "enum": [
                "stable",
                "beta",
                "alpha"
              ],
              "type": "string"
            },
            "frc_season": {
              "description": "FRC season, e.g. 2026",
              "pattern": "^20[2-3][0-9]$",
              "type": "string"
            },
            "language": {
              "description": "java, cpp or python",
              "enum": [
                "java",
                "cpp",
                "python"
              ],
              "type": "string"
            }
          },
          "type": [
            "null",
            "object"
          ]
        },
        "project_root": {
          "description": "robot project directory (default: the server's working directory); unavailable on hosted servers",
          "type": "string"
        }
      },
      "type": "object"
    },
