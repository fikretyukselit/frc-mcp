          "type": "string"
        },
        "freshness": {
          "description": "shard (served from the local index) | live",
          "type": "string"
        },
        "hits": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "citation": {
                "additionalProperties": false,
                "properties": {
                  "library": {
                    "description": "library id, e.g. wpilib, phoenix6, revlib",
                    "type": "string"
                  },
                  "license": {
